      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * (sum(increase(gatus_results_total{success=\"true\", group=~\"$group\", name=~\"$service\"}[$__range])) / sum(increase(gatus_results_total{group=~\"$group\", name=~\"$service\"}[$__range])))",
          "legendFormat": "Uptime %",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Overall Uptime %",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
