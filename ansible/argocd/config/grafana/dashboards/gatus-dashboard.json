      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "100 * (sum by (group, name) (increase(gatus_results_total{success=\"true\", group=~\"$group\", name=~\"$service\"}[24h])) / sum by (group, name) (increase(gatus_results_total{group=~\"$group\", name=~\"$service\"}[24h])))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "sum by (group, name) (increase(gatus_results_total{success=\"false\", group=~\"$group\", name=~\"$service\"}[24h]))",
          "format": "table",
          "hide": false,
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "avg by (group, name) (avg_over_time(gatus_results_duration_seconds{group=~\"$group\", name=~\"$service\"}[24h]))",
          "format": "table",
          "hide": false,
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "C"
        }
      ],
      "title": "Service Summary Table",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Time": 0,
              "Value #A": 4,
              "Value #B": 5,
              "Value #C": 6,
              "group": 1,
              "name": 2
            },
            "renameByName": {
              "Value #A": "Uptime %",
              "Value #B": "Failures (24h)",
              "Value #C": "Avg Response Time",
              "group": "Group",
              "name": "Service"
            }
          }
        }
      ],
      "type": "table"
    }
