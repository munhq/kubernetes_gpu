        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "last",
            "sum"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "rate(gatus_results_total{success=\"false\", group=~\"$group\", name=~\"$service\"}[5m]) * 60",
          "legendFormat": "{{group}} - {{name}} (failures/min)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Failure Rate Over Time",
      "type": "timeseries"
