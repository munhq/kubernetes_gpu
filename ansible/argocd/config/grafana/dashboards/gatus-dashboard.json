                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 95
                    },
                    {
                      "color": "yellow",
                      "value": 98
                    },
                    {
                      "color": "green",
                      "value": 99.5
                    }
