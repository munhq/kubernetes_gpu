      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "gatus_results_certificate_expiration_seconds{group=~\"$group\", name=~\"$service\"}",
          "legendFormat": "{{group}} - {{name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Certificate Expiration",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "hideFrom": {
              "tooltip": false,
