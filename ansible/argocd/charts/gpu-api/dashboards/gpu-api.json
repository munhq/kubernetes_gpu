          }
        ]
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 23 },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
