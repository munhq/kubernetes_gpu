# K3s Server Configuration
# Generated by Ansible

node-name: {{ inventory_hostname }}
cluster-init: true
write-kubeconfig-mode: "0644"

# Bind to Netbird VPN IP for inter-node communication
node-ip: {{ netbird_vpn_ip }}
advertise-address: {{ netbird_vpn_ip }}

# Flannel networking over Netbird VPN:
# flannel-iface: binds the VXLAN device (flannel.1) to wt0 so it sends/receives
#   encapsulated packets through the VPN tunnel, not the public eth0 interface.
# node-external-ip + flannel-external-ip: sets the PublicIP annotation to the VPN IP
#   so remote nodes know to send VXLAN packets to this node's VPN address.
# Both are needed: iface controls where flannel.1 listens, external-ip controls
# what destination IP remote nodes use for VXLAN.
flannel-iface: wt0
node-external-ip: {{ netbird_vpn_ip }}
flannel-external-ip: true

# Disable cloud controller (bare metal setup)
disable-cloud-controller: true

{% if k3s_disable is defined and k3s_disable | length > 0 %}
disable:
{% for item in k3s_disable %}
  - {{ item }}
{% endfor %}
{% endif %}

tls-san:
  - {{ ansible_host }}
  - {{ netbird_vpn_ip }}
  - {{ inventory_hostname }}
  - 127.0.0.1

{% if k3s_kubelet_args is defined and k3s_kubelet_args | length > 0 %}
kubelet-arg:
{% for arg in k3s_kubelet_args %}
  - "{{ arg }}"
{% endfor %}
{% endif %}

# Enable metrics
etcd-expose-metrics: true
